#!/bin/sh
# Runs CI's jobs for what each pushed ref changes, here, against the pushed
# commit and never the working tree. Skip with `git push --no-verify`.
set -eu

cd "$(git rev-parse --show-toplevel)"

if ! command -v uv >/dev/null 2>&1; then
    printf 'pre-push: running CI here needs uv (https://docs.astral.sh/uv/)\n' >&2
    exit 1
fi

missing_commit=0000000000000000000000000000000000000000
while read -r _local_ref local_commit remote_ref remote_commit; do
    [ "$local_commit" = "$missing_commit" ] && continue
    base_argument=""
    if [ "$remote_commit" != "$missing_commit" ] && git cat-file -e "$remote_commit^{commit}" 2>/dev/null; then
        base_argument="--base=$remote_commit"
    fi
    printf 'pre-push: running CI here for %s\n' "$remote_ref" >&2
    if ! timeout 600 uv run --quiet --script tools/ci/local_ci.py --head "$local_commit" ${base_argument:---all} >&2; then
        printf 'pre-push: CI fails here for %s, so the push is refused\n' "$remote_ref" >&2
        exit 1
    fi
done
