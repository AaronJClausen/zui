#!/bin/sh
# Checks what is staged, never the working tree, except for `zig build check`.
# Skip with `git commit --no-verify`.
set -eu

cd "$(git rev-parse --show-toplevel)"

failures=0
fail() {
    printf 'pre-commit: %s\n' "$1" >&2
    failures=$((failures + 1))
}
warn() {
    printf 'pre-commit: warning: %s\n' "$1" >&2
}

staged_files() {
    git diff --cached --name-only --no-renames --diff-filter="$1"
}

is_staged() {
    staged_files ACMRD | grep -qxF "$1"
}

any_staged_matching() {
    staged_files ACMRD | grep -qE "$1"
}

added_or_modified=$(staged_files ACMR)
added=$(staged_files A)
[ -n "$(staged_files ACMRD)" ] || exit 0

# Licence texts are kept verbatim, trailing spaces and all.
if ! git diff --cached --check -- . ':(exclude)text/fonts/*.txt' >&2; then
    fail "whitespace errors or conflict markers in the staged changes (above)"
fi

build_output_pattern='(^|/)(zig-out|\.zig-cache|zig-pkg)/'
largest_allowed_bytes=1048576
printf '%s\n' "$added_or_modified" | while IFS= read -r path; do
    [ -n "$path" ] || continue
    if printf '%s\n' "$path" | grep -qE "$build_output_pattern"; then
        printf 'pre-commit: %s is build output; unstage it with `git rm --cached`\n' "$path" >&2
        echo failed
    fi
    size=$(git cat-file -s ":$path")
    if [ "$size" -gt "$largest_allowed_bytes" ]; then
        printf 'pre-commit: %s is %s bytes, over the 1 MiB limit\n' "$path" "$size" >&2
        echo failed
    fi
done | grep failed >/dev/null && failures=$((failures + 1))

printf '%s\n' "$added_or_modified" | grep -E '\.zig(\.zon)?$' | while IFS= read -r path; do
    case "$path" in
    # Generated by sokol-shdc, so formatting leaves it alone.
    *.glsl.zig) ;;
    *)
        language_flag=""
        case "$path" in *.zon) language_flag="--zon" ;; esac
        if ! git show ":$path" | zig fmt --stdin $language_flag --check >/dev/null 2>&1; then
            printf 'pre-commit: %s is not formatted; run `zig build fmt` and stage it\n' "$path" >&2
            echo failed
        fi
        ;;
    esac
    case "$path" in
    *.zig)
        if ! errors=$(git show ":$path" | zig ast-check 2>&1); then
            printf '%s\n' "$errors" | sed "s|^<stdin>|$path|" >&2
            echo failed
        fi
        ;;
    esac
done | grep failed >/dev/null && failures=$((failures + 1))

if any_staged_matching '^\.mdformat\.toml$|^tools/mdformat/'; then
    markdown_to_check=$(git ls-files -- '*.md')
else
    markdown_to_check=$(printf '%s\n' "$added_or_modified" | grep -E '\.md$' || true)
fi
# A tree from before the formatter has no settings to check against.
git cat-file -e :.mdformat.toml 2>/dev/null || markdown_to_check=""
if [ -n "$markdown_to_check" ]; then
    if ! command -v uvx >/dev/null 2>&1; then
        fail "Markdown is staged, and checking its formatting needs uv (https://docs.astral.sh/uv/)"
    else
        repository=$(pwd)
        staged_copy=$(mktemp -d)
        # The formatter reads its settings from beside the files, so the staged ones come along.
        printf '%s\n' .mdformat.toml $markdown_to_check | git checkout-index --prefix="$staged_copy/" --stdin
        if ! (cd "$staged_copy" && uvx --quiet --from "$repository/tools/mdformat" mdformat-zui --check $markdown_to_check) >&2; then
            fail "Markdown is not formatted (above); run \`zig build fmt-md\` and stage it"
        fi
        rm -rf "$staged_copy"
    fi
fi

for package in core apps/tour; do
    if printf '%s\n' "$added" | grep -qE "^$package/tests/compile_errors/[^/]+\.zig$" && ! is_staged "$package/build.zig"; then
        fail "a new compile-error case in $package/tests/compile_errors/ needs its row in compile_error_cases in $package/build.zig"
    fi
done

printf '%s\n' "$added_or_modified" | grep -E '^renderers/sokol/src/[^/]+\.glsl$' | while IFS= read -r shader; do
    if ! is_staged "$shader.zig"; then
        printf 'pre-commit: %s changed without %s.zig; run `zig build shaders` in renderers/sokol and stage it\n' "$shader" "$shader" >&2
        echo failed
    fi
done | grep failed >/dev/null && failures=$((failures + 1))

printf '%s\n' "$added" | grep -E '^core/(zui_[a-z_]+)/\1\.zig$' | while IFS= read -r module; do
    for registration in core/build.zig core/build.zig.zon build.zig; do
        if ! is_staged "$registration"; then
            printf 'pre-commit: the new module %s needs registering in %s\n' "$module" "$registration" >&2
            echo failed
        fi
    done
done | grep failed >/dev/null && failures=$((failures + 1))

if [ "$failures" -gt 0 ]; then
    printf 'pre-commit: commit refused\n' >&2
    exit 1
fi

if any_staged_matching '^core/|^build\.zig(\.zon)?$|^tests/'; then
    if ! timeout 60 zig build check >&2; then
        printf 'pre-commit: `zig build check` failed\n' >&2
        exit 1
    fi
fi

if git diff --cached -U0 -- core/src | grep -qE '^[+-][[:space:]]*pub ' && ! any_staged_matching '\.md$'; then
    warn "a pub declaration in core/src/ changed, but no document is staged"
fi
if is_staged ROADMAP.md && ! any_staged_matching '^roadmap/.+\.md$'; then
    warn "ROADMAP.md changed, but no item in roadmap/ did"
fi
