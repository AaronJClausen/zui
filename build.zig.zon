.{
    .name = .zui,
    .version = "0.5.0",
    .fingerprint = 0xc00160dbaadffbc5, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zui_core = .{ .path = "core" },
        .zui_glyphs = .{ .path = "text/glyphs" },
        .zui_fonts = .{ .path = "text/fonts" },
        .zui_truetype = .{ .path = "text/truetype" },
        .zui_terminal = .{ .path = "renderers/terminal" },
        .zui_raylib = .{ .path = "renderers/raylib" },
        .zui_sokol = .{ .path = "renderers/sokol" },
        .zui_webgl = .{ .path = "renderers/webgl" },
        .zui_host = .{ .path = "hosts/native" },
        .zui_web = .{ .path = "hosts/web" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "text/glyphs",
        "text/fonts",
        "text/truetype",
        "themes",
        "examples",
        "renderers/terminal",
        "renderers/raylib",
        "renderers/sokol",
        "renderers/webgl",
        "hosts/native",
        "hosts/web",
        "LICENSE",
        "README.md",
        "SPEC.md",
    },
}
