.{
    .name = .zui,
    .version = "0.5.0",
    .fingerprint = 0xc00160dbaadffbc5, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zui_core = .{ .path = "core" },
        .zui_terminal = .{ .path = "renderers/terminal" },
        .zui_raylib = .{ .path = "renderers/raylib" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "themes",
        "examples",
        "renderers/terminal",
        "renderers/raylib",
        "LICENSE",
        "README.md",
        "SPEC.md",
    },
}
