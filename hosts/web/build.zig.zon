.{
    .name = .zui_web,
    .version = "0.1.0",
    .fingerprint = 0x635f27e251b03f0d, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zui_core = .{ .path = "../../core" },
        .zui_webgl = .{ .path = "../../renderers/webgl" },
        .zui_glyphs = .{ .path = "../../text/glyphs" },
        .zui_truetype = .{ .path = "../../text/truetype" },
        .zui_fonts = .{ .path = "../../text/fonts" },
        .zui_sokol = .{ .path = "../../renderers/sokol", .lazy = true },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools", "web" },
}
