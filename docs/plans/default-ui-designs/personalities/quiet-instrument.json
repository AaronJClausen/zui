{
  "personality": {
    "id": "quiet",
    "name": "Quiet instrument",
    "summary": "For tools and pro apps: tight, outlined, almost no color until something is selected.",
    "design": {
      "seeds": {
        "accent": {
          "lightness": 0.55,
          "chroma": 0.12,
          "hue": 250
        },
        "neutral": {
          "lightness": 0.5,
          "chroma": 0.004,
          "hue": 250
        }
      },
      "type": {
        "ratio": 1.15,
        "body_size": 14,
        "x_height": 5.6
      },
      "shapes": {
        "control": "sharp",
        "container": "smooth",
        "popup": "smooth",
        "chip": "smooth",
        "image": "sharp",
        "indicator": "bubble"
      },
      "corner_shape": "round"
    },
    "preferences": {
      "density": "compact"
    },
    "skin": {
      "card": "outline_muted border, elevation 0",
      "button_secondary": "surface with an outline border",
      "inputs": "surface with an outline border",
      "tabs": "underline"
    }
  },
  "page_css": [
    ".zp-quiet { --r-control: 4px; --r-container: 8px; --r-popup: 8px; --r-chip: 8px; --r-image: 4px; }",
    ".zp-quiet .z-card, .zp-quiet .z-list { box-shadow: 0 0 0 1px var(--z-outline_muted); }",
    ".zp-quiet .z-input { background: var(--z-surface); box-shadow: inset 0 0 0 1px var(--z-outline); }",
    ".zp-quiet .z-secondary { background: var(--z-surface); box-shadow: inset 0 0 0 1px var(--z-outline); color: var(--z-on_surface); }",
    ".zp-quiet .persona-stage { font-size: 14px; }"
  ],
  "page_notes": [
    "The page drew this personality with the default design's type scale (Atkinson Hyperlegible at 16, ratio 1.2); design.type above was declared but not drawn.",
    "Corner radii were drawn from the CSS above, not from design.shapes: page_css is exactly what the page used.",
    "Colors were resolved from personality.design.seeds with the default tones, so resolved holds each role's idle color as the page drew it."
  ],
