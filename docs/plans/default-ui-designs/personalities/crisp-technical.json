{
  "personality": {
    "id": "crisp",
    "name": "Crisp technical",
    "summary": "For dashboards and makers: chamfered corners, mono numbers and labels, a vivid accent saved for focus and selection.",
    "design": {
      "seeds": {
        "accent": {
          "lightness": 0.55,
          "chroma": 0.15,
          "hue": 160
        },
        "neutral": {
          "lightness": 0.5,
          "chroma": 0.01,
          "hue": 220
        }
      },
      "type": {
        "ratio": 1.25,
        "body_size": 15,
        "x_height": 6
      },
      "shapes": {
        "control": "sharp",
        "container": "sharp",
        "popup": "sharp",
        "chip": "sharp",
        "image": "square",
        "indicator": "square"
      },
      "corner_shape": "chamfer"
    },
    "preferences": {
      "density": "comfortable"
    },
    "skin": {
      "card": "surface_sunken fill, outline_muted border",
      "button_secondary": "outline border, transparent",
      "inputs": "surface_sunken with an outline bottom edge",
      "labels": "label role drawn in the monospace font, uppercase, +6% tracking",
      "tabs": "underline in accent"
    }
  },
  "page_css": [
    ".zp-crisp { --r-control: 4px; --r-container: 4px; --r-popup: 4px; --r-chip: 4px; --r-image: 0px; --r-indicator: 0px; }",
    ".zp-crisp .z-card, .zp-crisp .z-input, .zp-crisp .z-btn, .zp-crisp .z-chip, .zp-crisp .z-list { corner-shape: bevel; }",
    ".zp-crisp .z-card, .zp-crisp .z-list { background: var(--z-surface_sunken); box-shadow: inset 0 0 0 1px var(--z-outline_muted); --r-container: 8px; }",
    ".zp-crisp .z-secondary { background: transparent; box-shadow: inset 0 0 0 1px var(--z-outline); color: var(--z-on_surface); }",
    ".zp-crisp .z-field-label, .zp-crisp .persona-label { font-family: var(--mono); font-weight: 400; text-transform: uppercase; letter-spacing: 0.06em; font-size: 11.5px; }",
    ".zp-crisp .num { font-family: var(--mono); }",
    ".zp-crisp .z-input { box-shadow: inset 0 -1.5px 0 var(--z-outline); }",
    ".zp-crisp .z-input:focus-within { box-shadow: inset 0 -2px 0 var(--z-accent); }"
  ],
  "page_notes": [
    "The page drew this personality with the default design's type scale (Atkinson Hyperlegible at 16, ratio 1.2); design.type above was declared but not drawn.",
    "Corner radii were drawn from the CSS above, not from design.shapes: page_css is exactly what the page used.",
    "Colors were resolved from personality.design.seeds with the default tones, so resolved holds each role's idle color as the page drew it."
  ],
